# Local development only. Never use this example password outside your machine.
APP_ENV=dev
FRONTEND_HOST_PORT=4200
BACKEND_HOST_PORT=8080
POSTGRES_HOST_PORT=5432
POSTGRES_DB=aurora_bakery
POSTGRES_USER=aurora_bakery
POSTGRES_PASSWORD=aurora-local-only
# Comma-separated explicit browser origins; update when changing frontend port.
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Requires APP_ENV=dev. False prevents inserts, but does not remove existing rows.
DEV_SEED_ENABLED=true
# Optional backend container UID/GID; must not conflict with base image users.
APP_UID=10001
APP_GID=10001
# Backend purchase policy; percentage from 0 to 100.
ADMIN_DISCOUNT_PERCENT=15
