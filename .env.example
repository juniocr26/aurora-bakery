# Local development only. Never use this example password outside your machine.
APP_ENV=dev
FRONTEND_HOST_PORT=4200
BACKEND_HOST_PORT=8080
POSTGRES_HOST_PORT=5432
POSTGRES_DB=payment_reconciliation_lab
POSTGRES_USER=payment_reconciliation_lab
POSTGRES_PASSWORD=change-me-local-only
# Comma-separated explicit browser origins; update when changing frontend port.
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
DEV_SEED_ENABLED=false
# Optional backend container UID/GID; must not conflict with base image users.
APP_UID=10001
APP_GID=10001
# Fresh installations only. Existing volumes require the transition guide.
POSTGRES_VOLUME_NAME=payment-reconciliation-lab_db_data
# Reserved: reconciliation fixtures are not implemented; true fails startup.
# Stripe integration is not implemented; reserved server-side test key only.
STRIPE_SECRET_KEY=
